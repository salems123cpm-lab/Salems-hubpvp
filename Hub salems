local function Button(parent,text,callback)
    local b=Instance.new("TextButton")
    b.Size=UDim2.new(1,0,0,37); b.BackgroundColor3=C.Panel; b.Text=text
    b.TextColor3=C.White; b.Font=Enum.Font.Gotham; b.TextSize=12; b.Parent=parent
    Corner(b,7); Border(b,ActiveColor,1); b.MouseButton1Click:Connect(callback); return b
end
local function Toggle(parent,text,initial,callback)
    local enabled=initial
    local b
    local function refresh()
        b.Text=text..(enabled and "  [ON]" or "  [OFF]")
        b.BackgroundColor3=enabled and Color3.fromRGB(30,90,50) or C.Panel
    end
    b=Button(parent,text,function() enabled=not enabled; refresh(); callback(enabled) end)
    refresh(); return b
end
local function Notify(text)
    pcall(function() game:GetService("StarterGui"):SetCore("SendNotification",{Title="SALEMS VIP",Text=text,Duration=3}) end)
end
