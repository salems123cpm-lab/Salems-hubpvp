    state.InfJump = enabled and true or false
    if updateInfUI then updateInfUI() end
    saveConfig()
end

local function setLogicVersion(version)
    if version ~= 1 and version ~= 2 then return end
    state.LogicVersion = version
    if updateLogicUI then updateLogicUI() end
    saveConfig()
end

local function setScale(value)
    state.UIScale = clamp(value, 0.75, 1.6)
    uiScale.Scale = state.UIScale
    if updateScaleUI then updateScaleUI() end
    saveConfig()
end

updateLogicUI = function()
    mobileLogic.Text = "LOGIC  ·  V" .. state.LogicVersion
    pcV1.BackgroundColor3 = state.LogicVersion == 1 and C.v1 or C.card
    pcV2.BackgroundColor3 = state.LogicVersion == 2 and C.v2 or C.card
    pcV1Stroke.Transparency = state.LogicVersion == 1 and 0.1 or 0.5
    pcV2Stroke.Transparency = state.LogicVersion == 2 and 0.1 or 0.5
end

updateAntiUI = function()
    local label = state.AntiBat and "ON" or "OFF"
    mobileAnti.Text = "ANTI BAT  ·  " .. label
    mobileAnti.BackgroundColor3 = state.AntiBat and C.accent or C.card
    antiStatus.Text = label
    antiStatus.TextColor3 = state.AntiBat and C.on or C.muted
    antiTrack.BackgroundColor3 = state.AntiBat and C.accent or C.dark
    local x = state.AntiBat and (antiTrackW - antiKnobSize - 3) or 3
    tween(antiKnob, { Position = UDim2.new(0, x, 0.5, -antiKnobSize / 2) })
    miniBat.Text = state.AntiBat and "BAT ON" or "BAT OFF"
    miniBat.BackgroundColor3 = state.AntiBat and C.accent or C.card
end

updateInfUI = function()
    local label = state.InfJump and "ON" or "OFF"
    mobileInf.Text = "INF JUMP  ·  " .. label
    mobileInf.BackgroundColor3 = state.InfJump and C.accent or C.card
    infStatus.Text = label
    infStatus.TextColor3 = state.InfJump and C.on or C.muted
    infTrack.BackgroundColor3 = state.InfJump and C.accent or C.dark
    local x = state.InfJump and (infTrackW - infKnobSize - 3) or 3
    tween(infKnob, { Position = UDim2.new(0, x, 0.5, -infKnobSize / 2) })
end

updateKeyUI = function()
    local name = bindingKey and "..." or state.Keybind.Name
    pcKey.Text = name
    pcKey.TextColor3 = bindingKey and C.accent2 or C.white
    mobileKey.Text = "KEY  ·  " .. name
end

updateLockUI = function()
    local glyph = state.Locked and "🔒" or "🔓"
    lockBtn.Text = glyph
    miniLock.Text = glyph
    lockBtn.TextColor3 = state.Locked and C.accent2 or C.white
    miniLock.TextColor3 = state.Locked and C.accent2 or C.white
end

updateModeUI = function()
    pcContent.Visible = not state.MobileMode
    mobileContent.Visible = state.MobileMode
    modeBtn.Text = state.MobileMode and "PC" or "MOB"
end

updateScaleUI = function()
    local text = string.format("%.0f%%", state.UIScale * 100)
    mobilePercent.Text = text
    pcPercent.Text = text
end

setCollapsed = function(collapsed)
    state.Collapsed = collapsed and true or false
    if state.Collapsed then
        main.Size = UDim2.new(0, 168, 0, 52)
        header.Visible = false
        topLine.Visible = false
        content.Visible = false
        miniBar.Visible = true
    else
        main.Size = UDim2.new(0, 310, 0, 340)
        header.Visible = true
        topLine.Visible = true
        content.Visible = true
        miniBar.Visible = false
    end
end

local function toggleLocked()
    state.Locked = not state.Locked
    updateLockUI()
end

local function beginKeyBind()
    bindingKey = true
    updateKeyUI()
end

local function toggleAntiFromUI()
    setAntiBat(not state.AntiBat)
end

local function toggleInfFromUI()
    setInfJump(not state.InfJump)
end

local function cycleLogic()
    setLogicVersion(state.LogicVersion == 1 and 2 or 1)
end

mobileLogic.MouseButton1Click:Connect(cycleLogic)
mobileAnti.MouseButton1Click:Connect(toggleAntiFromUI)
mobileInf.MouseButton1Click:Connect(toggleInfFromUI)
mobileKey.MouseButton1Click:Connect(beginKeyBind)
mobileMinus.MouseButton1Click:Connect(function() setScale(state.UIScale - 0.1) end)
mobilePlus.MouseButton1Click:Connect(function() setScale(state.UIScale + 0.1) end)

pcV1.MouseButton1Click:Connect(function() setLogicVersion(1) end)
pcV2.MouseButton1Click:Connect(function() setLogicVersion(2) end)
antiHit.MouseButton1Click:Connect(toggleAntiFromUI)
infHit.MouseButton1Click:Connect(toggleInfFromUI)
pcKey.MouseButton1Click:Connect(beginKeyBind)
pcMinus.MouseButton1Click:Connect(function() setScale(state.UIScale - 0.1) end)
pcPlus.MouseButton1Click:Connect(function() setScale(state.UIScale + 0.1) end)

lockBtn.MouseButton1Click:Connect(toggleLocked)
miniLock.MouseButton1Click:Connect(toggleLocked)
swapBtn.MouseButton1Click:Connect(function() setCollapsed(not state.Collapsed) end)
miniExpand.MouseButton1Click:Connect(function() setCollapsed(false) end)
miniBat.MouseButton1Click:Connect(toggleAntiFromUI)
modeBtn.MouseButton1Click:Connect(function()
    state.MobileMode = not state.MobileMode
    updateModeUI()
    saveConfig()
end)

track(UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if input.UserInputType == Enum.UserInputType.Keyboard then
        if bindingKey then
            if input.KeyCode ~= Enum.KeyCode.Unknown then
                state.Keybind = input.KeyCode
                bindingKey = false
                updateKeyUI()
                saveConfig()
            end
            return
        end
        if not gameProcessed and input.KeyCode == state.Keybind then
            setCollapsed(not state.Collapsed)
            return
        end
        if not gameProcessed and input.KeyCode == Enum.KeyCode.Space then
            spaceHeld = true
        end
    end
end))

track(UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.Space then
        spaceHeld = false
    end
end))

header.InputBegan:Connect(function(input)
    if state.Locked then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPosition = main.Position
    end
end)

track(UserInputService.InputChanged:Connect(function(input)
    if not dragging or state.Locked then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement
        and input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end
    local delta = input.Position - dragStart
    main.Position = UDim2.new(
        startPosition.X.Scale,
        startPosition.X.Offset + delta.X,
        startPosition.Y.Scale,
        startPosition.Y.Offset + delta.Y
    )
end))

track(UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end))

-- Initial paint.
updateLogicUI()
updateAntiUI()
updateInfUI()
updateKeyUI()
updateLockUI()
updateModeUI()
updateScaleUI()
setCollapsed(false)

if state.AntiBat then
    startGuard()
end

local function cleanup()
    stopGuard()
    for _, conn in ipairs(connections) do
        pcall(function() conn:Disconnect() end)
    end
end

gui.Destroying:Connect(cleanup)

