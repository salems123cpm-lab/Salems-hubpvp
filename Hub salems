local function aplicarAnimacion(tipo)
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        local animate = char:FindFirstChild("Animate")
        if not animate then return end
        
        if tipo == "Zombie" then
            animate.walk.WalkAnim.AnimationId = "rbxassetid://616158751"
            animate.run.RunAnim.AnimationId = "rbxassetid://616163682"
            animate.idle.Animation1.AnimationId = "rbxassetid://616158929"
        elseif tipo == "Adidas" then
            animate.walk.WalkAnim.AnimationId = "rbxassetid://3338006114"
            animate.run.RunAnim.AnimationId = "rbxassetid://3338009846"
        elseif tipo == "Comics" then
            animate.walk.WalkAnim.AnimationId = "rbxassetid://742637544"
            animate.run.RunAnim.AnimationId = "rbxassetid://742638842"
        end
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do track:Stop() end
        end
    end)
end

