local function defaultConfig()
    return {
        AntiBat = state.AntiBat,
        InfJump = state.InfJump,
        LogicVersion = state.LogicVersion,
        UIScale = state.UIScale,
        Keybind = state.Keybind.Name,
        MobileMode = state.MobileMode,
    }
end

local function loadConfig()
    if not isfile or not readfile then return end
    local ok, exists = pcall(isfile, CONFIG_FILE)
    if not ok or not exists then return end

    local readOk, raw = pcall(readfile, CONFIG_FILE)
    if not readOk or type(raw) ~= "string" then return end

    local decodeOk, data = pcall(function()
        return HttpService:JSONDecode(raw)
    end)
    if not decodeOk or type(data) ~= "table" then return end

    if type(data.AntiBat) == "boolean" then state.AntiBat = data.AntiBat end
    if type(data.InfJump) == "boolean" then state.InfJump = data.InfJump end
    if data.LogicVersion == 1 or data.LogicVersion == 2 then
        state.LogicVersion = data.LogicVersion
    end
    if type(data.UIScale) == "number" then
        state.UIScale = clamp(data.UIScale, 0.75, 1.6)
    end
    if type(data.MobileMode) == "boolean" then
        state.MobileMode = data.MobileMode
    end
    if type(data.Keybind) == "string" then
        local keyOk, key = pcall(function()
            return Enum.KeyCode[data.Keybind]
        end)
        if keyOk and key then state.Keybind = key end
    end
end

local function saveConfig()
    if not writefile then return end
    pcall(function()
        writefile(CONFIG_FILE, HttpService:JSONEncode(defaultConfig()))
    end)
end

