-- ---------------------------------------------------------------------------
-- Safe character guard. No 1000-stud impulse, no anchoring, no input disabling.
-- ---------------------------------------------------------------------------

local connections = {}
local guardConnection = nil
local lastVelocity = Vector3.new(0, 0, 0)
local spaceHeld = false
local lastInfJump = 0

local function track(conn)
    table.insert(connections, conn)
    return conn
end

local function getCharacter()
    local character = player.Character
    if not character then return nil, nil, nil end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root and humanoid then root = humanoid.RootPart end
    return character, humanoid, root
end

local function getVelocity(root)
    local ok, velocity = pcall(function()
        return root.AssemblyLinearVelocity
    end)
    if ok and typeof(velocity) == "Vector3" then
        return velocity
    end
    return root.Velocity
end

local function setVelocity(root, velocity)
    local ok = pcall(function()
        root.AssemblyLinearVelocity = velocity
    end)
    if not ok then
        pcall(function()
            root.Velocity = velocity
        end)
    end
end

local function setAngularVelocity(root, velocity)
    local ok = pcall(function()
        root.AssemblyAngularVelocity = velocity
    end)
    if not ok then
        pcall(function()
            root.RotVelocity = velocity
        end)
    end
end

local function enableControls()
    pcall(function()
        local playerScripts = player:FindFirstChild("PlayerScripts")
        if not playerScripts then return end
        local playerModule = playerScripts:FindFirstChild("PlayerModule")
        if not playerModule then return end
        local controlModule = playerModule:FindFirstChild("ControlModule")
        if not controlModule then return end
        require(controlModule):Enable()
    end)
end

local function reenableMotors(character)
    for _, descendant in ipairs(character:GetDescendants()) do
        if descendant:IsA("Motor6D") and not descendant.Enabled then
            descendant.Enabled = true
        end
    end
end

local function isRagdollState(humanoid)
    local s = humanoid:GetState()
    return s == Enum.HumanoidStateType.Physics
        or s == Enum.HumanoidStateType.Ragdoll
        or s == Enum.HumanoidStateType.FallingDown
end

local function guardStep(dt)
    local character, humanoid, root = getCharacter()
    if not character or not humanoid or not root or humanoid.Health <= 0 then
        return
    end

    local velocity = getVelocity(root)
    local delta = (velocity - lastVelocity).Magnitude
    local ragdoll = isRagdollState(humanoid)
    local suddenHit = delta > SAFE_GUARD.SpikeDelta and dt > 0 and dt < SAFE_GUARD.MaxFrameDelta

    if ragdoll and SAFE_GUARD.RecoverRagdoll then
        pcall(function()
            humanoid:ChangeState(Enum.HumanoidStateType.Running)
        end)
        local camera = workspace.CurrentCamera
        if camera then camera.CameraSubject = humanoid end
        enableControls()
        setVelocity(root, Vector3.new(0, 0, 0))
        setAngularVelocity(root, Vector3.new(0, 0, 0))
        reenableMotors(character)
    elseif suddenHit then
        -- Preserve the player's current movement input instead of freezing them.
        local intended = humanoid.MoveDirection * humanoid.WalkSpeed
        local safeY = clamp(velocity.Y, -SAFE_GUARD.MaxVerticalAfterHit, SAFE_GUARD.MaxVerticalAfterHit)
        setVelocity(root, Vector3.new(intended.X, safeY, intended.Z))
        setAngularVelocity(root, Vector3.new(0, 0, 0))
    end

    lastVelocity = getVelocity(root)
end

local function startGuard()
    if guardConnection then return end
    local _, _, root = getCharacter()
    lastVelocity = root and getVelocity(root) or Vector3.new(0, 0, 0)
    guardConnection = RunService.Heartbeat:Connect(guardStep)
end

local function stopGuard()
    if guardConnection then
        guardConnection:Disconnect()
        guardConnection = nil
    end
end

local function infJumpStep()
    if not state.InfJump or not spaceHeld then return end
    local now = os.clock()
    if now - lastInfJump < 0.22 then return end

    local _, humanoid = getCharacter()
    if not humanoid or humanoid.Health <= 0 then return end

    local s = humanoid:GetState()
    local allowed = state.LogicVersion == 1
        or s == Enum.HumanoidStateType.Jumping
        or s == Enum.HumanoidStateType.Freefall
    if allowed then
        lastInfJump = now
        pcall(function()
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end)
    end
end

track(RunService.Heartbeat:Connect(infJumpStep))

track(UserInputService.JumpRequest:Connect(function()
    if not state.InfJump then return end
    local _, humanoid = getCharacter()
    if not humanoid or humanoid.Health <= 0 then return end
    local s = humanoid:GetState()
    if state.LogicVersion == 1 or s == Enum.HumanoidStateType.Jumping or s == Enum.HumanoidStateType.Freefall then
        pcall(function()
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end)
    end
end))

track(player.CharacterAdded:Connect(function()
