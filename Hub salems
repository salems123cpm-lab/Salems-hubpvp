-- ESP local
local function ClearESP(category)
    for object,data in pairs(Marks) do
        if not category or data.Category==category then
            if data.Highlight then data.Highlight:Destroy() end
            if data.Billboard then data.Billboard:Destroy() end
            Marks[object]=nil
        end
    end
end
local function AddESP(object,category,color)
    if Marks[object] or object==Player.Character then return end
    if not object:IsA("Model") and not object:IsA("BasePart") then return end
    local highlight=Instance.new("Highlight")
    highlight.Name="SalemsLocalHighlight"; highlight.Adornee=object; highlight.FillColor=color
    highlight.OutlineColor=color; highlight.FillTransparency=0.75
    highlight.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop; highlight.Parent=GUI
    local part=object:IsA("BasePart") and object or object.PrimaryPart or object:FindFirstChildWhichIsA("BasePart",true)
    local billboard
    if part then
        billboard=Instance.new("BillboardGui"); billboard.Adornee=part; billboard.Size=UDim2.fromOffset(170,30)
        billboard.StudsOffset=Vector3.new(0,3,0); billboard.AlwaysOnTop=true; billboard.Parent=GUI
        local text=Instance.new("TextLabel"); text.Size=UDim2.fromScale(1,1); text.BackgroundTransparency=1
        text.TextColor3=color; text.TextStrokeTransparency=0.2; text.Font=Enum.Font.GothamBold
        text.TextSize=12; text.Text=object.Name; text.Parent=billboard
    end
    Marks[object]={Highlight=highlight,Billboard=billboard,Category=category}
end
local function Contains(name,keywords)
    name=string.lower(name)
    for _,keyword in ipairs(keywords) do if string.find(name,keyword,1,true) then return true end end
    return false
end
local EnemyNames={"wolf","deer","cultist","monster","bear","owl","enemy","monstruo","enemigo"}
local ResourceNames={"tree","wood","log","scrap","stone","coal","chest","crate","rock","ore","madera","piedra","cofre","arbol","árbol"}
local function ScanESP()
    if Settings.PlayerESP then
        for _,p in ipairs(Players:GetPlayers()) do
            if p~=Player and p.Character then AddESP(p.Character,"Players",Color3.fromRGB(60,170,255)) end
        end
    else ClearESP("Players") end
    for _,obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") then
            if Settings.EnemyESP and Contains(obj.Name,EnemyNames) then AddESP(obj,"Enemies",C.Red) end
            if Settings.ResourceESP and Contains(obj.Name,ResourceNames) then AddESP(obj,"Resources",C.Green) end
        end
    end
    if not Settings.EnemyESP then ClearESP("Enemies") end
    if not Settings.ResourceESP then ClearESP("Resources") end
end

