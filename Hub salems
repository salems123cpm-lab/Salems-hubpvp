-- Safe replacement for the original 1000-stud impulse.
local SAFE_GUARD = {
    -- A sudden velocity change above this is treated as knockback, not walking.
    SpikeDelta = 110,
    -- Only evaluate spikes on normal-length frames.
    MaxFrameDelta = 0.2,
    -- After a detected hit, keep vertical motion bounded instead of launching.
    MaxVerticalAfterHit = 80,
    -- Re-enableMotor6D joints only when a ragdoll state is detected.
    RecoverRagdoll = true,
}

local function clamp(x, lo, hi)
    if x < lo then return lo end
    if x > hi then return hi end
    return x
end

